upstream atlas_publication_upstream {
    server ${ATLAS_PUBLICATION_UPSTREAM};
    keepalive 16;
}

server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    root /usr/share/nginx/html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Cache-Control no-store always;
    add_header X-Oteryn-Atlas-Code-Revision "${ATLAS_CODE_REVISION}" always;

    location = / {
        return 302 /web/fullworld.html;
    }

    # Reuse read-only publication connections during long checkout-overlay suites.
    location ^~ /fullworld/ {
        proxy_pass ${ATLAS_PUBLICATION_SCHEME}://atlas_publication_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host "${ATLAS_PUBLICATION_HOST_HEADER}";
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_ssl_name "${ATLAS_PUBLICATION_HOST}";
        proxy_buffering off;
    }

    location ^~ /data/creatures/ {
        proxy_pass ${ATLAS_PUBLICATION_SCHEME}://atlas_publication_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host "${ATLAS_PUBLICATION_HOST_HEADER}";
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_ssl_name "${ATLAS_PUBLICATION_HOST}";
        proxy_buffering off;
    }

    location ~* \.mjs$ {
        default_type application/javascript;
        try_files $uri =404;
    }

    location / {
        try_files $uri =404;
    }
}
