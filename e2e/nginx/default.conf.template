server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    root /usr/share/nginx/html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Cache-Control no-store always;
    add_header X-Oteryn-Atlas-Code-Revision "${ATLAS_CODE_REVISION}" always;

    location = / {
        return 302 /web/fullworld.html;
    }

    # Full-world products are intentionally not committed to the Atlas source
    # repository. Keep the current checkout as the code authority while
    # proxying only the cryptographically verified publication families from
    # an explicitly selected preview/publication origin.
    location ^~ /fullworld/ {
        proxy_pass ${ATLAS_PUBLICATION_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
    }

    # Creature search is an optional published extension on the current main.
    location ^~ /data/creatures/ {
        proxy_pass ${ATLAS_PUBLICATION_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
    }

    # nginx's stock mime.types is not guaranteed to include ES-module .mjs.
    location ~* \.mjs$ {
        default_type application/javascript;
        try_files $uri =404;
    }

    location / {
        try_files $uri =404;
    }
}
